# hive-tools configuration. Copy to .env and fill in real values.
#
# Keep the real file OUTSIDE hive-mind's checkout, at
# ${HIVE_TOOLS_STATE_DIR:-~/.config/hive-tools}/.env, with `credentials/` and
# `data/` beside it: minds and bots mount the checkout and must not read these.
# deploy.sh and docker-compose.yml read it from there. Do not set HIVE_DATA_DIR:
# the data package is the checkout's own modules/hive-data.
#
# This service has no sign-in of its own and no admin password: a person acts
# with their own key, from the hive site.

# --- Core ---
HIVE_LOG_LEVEL=INFO

# The hive's one Postgres (the `tools` schema), through hive_data. Required:
# hive-tools refuses to start without it.
HIVE_DATABASE_URL=postgresql://hive:...@hive-postgres:5432/hive

# --- Host paths (consumed by docker-compose.yml) ---
HOST_DEV_DIR=/path/to/your/dev/root
HIVE_MIND_DIR=/path/to/your/hive_mind
HF_HOME=/path/to/your/.cache/huggingface

# --- Hive services ---
# Container ports on the hivemind network, not the host-published 8426/8425.
# hive-tools holds no key for the gateway: the SMS inbound toggle goes with
# the key of whoever asks. A gated call is held open until a person decides it
# and answered on the same call, so nothing is sent to a mind afterwards.
COMMS_URL=http://hive-comms:8424
LUCENT_URL=http://hive-lucent:8424
# The hive site as a person's browser reaches it. An approval notice links to
# HIVE_SITE_PUBLIC_URL/approvals/<id>; unset, the tools warn at start and the
# notice carries only the path.
HIVE_SITE_PUBLIC_URL=http://hive-host:8710

# --- Approvals: how long a gated call is held open for a person's yes ---
# A mind's call to a gated tool (send mail, post, compose up...) stays open
# while the owner of the mind, or an administrator, approves or denies it on
# the hive site. If nobody does within this many seconds the same call is
# answered with a plain refusal and the mind is told no. Default 110 (just
# under a shell tool's two minute default call limit, so the mind always sees
# the refusal; the hive site's 310 second calls outlast it). Zero refuses at once. A mind whose own tool call
# limit is shorter than this wait should be given a wait below it.
HITL_WAIT_SECONDS=110

# --- Model calls: the inference proxy ---
# /ollama/structured, /ollama/chat and /ollama/models are answered by the
# hive's inference proxy, never by Ollama. The hive-mind installer hands it
# the hive's one proxy key; by hand, mint it a key of its own with
# `python -m app.cli mint-key --client hive-tools` in the proxy.
# The default model is what a call naming none is sent to; it must be one the
# proxy serves. Each unset one is a 503 naming it.
INFERENCE_PROXY_URL=http://host.docker.internal:8899
INFERENCE_PROXY_KEY=
HIVE_TOOLS_DEFAULT_MODEL=gpt-oss:20b-32k

# --- Training ---
# Deploy imports a trained model into the Ollama on the machine that trained
# it, and a launch evicts that Ollama's models from VRAM first. Model
# management on the GPU host, not a model call.
TRAINING_OLLAMA_URL=http://host.docker.internal:11434

# --- Telegram (notify tool) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# --- SMS gateway (android-sms-gateway, private-server mode) ---
SMS_GATEWAY_URL=http://sms-gateway:3000
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=
SMS_GATEWAY_PRIVATE_TOKEN=
SMS_GATEWAY_JWT_SECRET=
SMS_GATEWAY_DB_ROOT_PASSWORD=
SMS_GATEWAY_DB_PASSWORD=

# --- Google OAuth (gmail / calendar tools) ---
# Place client_secret.json in credentials/; tokens are written beside it.
