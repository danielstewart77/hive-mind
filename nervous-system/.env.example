# Bearer tokens for lucent (/memory/*, /graph/*) and comms (the gateway).
# Empty = bypass mode (a startup warning is logged and all routes accept
# any/no Authorization header). Set both in production. 43+ chars
# recommended. COMMS_BEARER_TOKEN must equal the same var in the repo
# root's .env — bots authenticate to comms with that value.
LUCENT_BEARER_TOKEN=
COMMS_BEARER_TOKEN=

# Admin-only bearer for schema-mutation / registry-admin endpoints on each
# service. Only hive-tools (or another trusted maintainer caller) should
# hold these. Leave empty to disable those endpoints entirely.
LUCENT_ADMIN_BEARER_TOKEN=
# The one credential that can change a Mind's soul, on /graph/soul. Neither
# the service bearer nor the admin bearer is accepted there: hive-tools holds
# admin, and hive-tools is the path a sub-mind's verdict travels. Unset locks
# the route (503) rather than opening it.
LUCENT_SOUL_BEARER_TOKEN=
COMMS_ADMIN_BEARER_TOKEN=

# Optional — only if you're using the SMS inbound webhook (see
# nervous-system/docs/sms-inbound.md). Signs incoming webhook requests.
# SMS_INBOUND_HMAC_SECRET=
