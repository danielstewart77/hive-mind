# Hive Mind — Secrets
# Copy to .env and fill in real values.

# Shared bearer token between hive-comms and every bot/mind that talks to
# it (docker-compose.example.yml interpolates ${COMMS_BEARER_TOKEN} into
# each bot's environment). Must equal the same var in nervous-system/.env —
# that's the value comms itself checks incoming requests against.
COMMS_BEARER_TOKEN=

# Surface bot tokens. Only the surfaces you actually run need a value —
# an unused bot container will just fail to log in, harmlessly.
DISCORD_BOT_TOKEN=your-discord-bot-token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_OWNER_CHAT_ID=your-telegram-chat-id

# SMTP — fallback notification channel when Telegram is unavailable.
# Gmail: use an App Password (myaccount.google.com/apppasswords), not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TO=your-email@gmail.com

# Optional overrides — every one of these has a working default in
# docker-compose.example.yml; set only if yours differs.
# HOST_PROJECT_DIR=.                        # bind-mounted into every container as /usr/src/app
# HOST_CLAUDE_DIR=~/.claude                 # host Claude CLI credentials, mounted read-only
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# KOKORO_DEFAULT_VOICE=af_heart
# KOKORO_VOICE_MAP={"ada":"af_bella","bob":"am_michael"}

# Optional — only if you're using X/Twitter search (tools/stateless/x_api/)
X_BEARER_TOKEN=your-x-bearer-token
